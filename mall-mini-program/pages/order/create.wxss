.create {
  padding: 20rpx 0;
  min-height: 100vh;
}

.card { margin: 0 20rpx 20rpx; }
.addr-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.form-item:last-child { border-bottom: none; }
.label {
  width: 120rpx;
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
}
.field {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}
.picker.placeholder { color: #999; }

.order-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.order-item:last-child { border-bottom: none; }
.item-img {
  width: 140rpx;
  height: 140rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  margin-right: 20rpx;
  overflow: hidden;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.item-img image { width: 100%; height: 100%; }
.item-img-ph { font-size: 56rpx; color: #ccc; }
.item-info { flex: 1; min-width: 0; }
.item-name {
  font-size: 28rpx;
  line-height: 36rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.item-sku {
  font-size: 22rpx;
  color: #999;
  margin: 8rpx 0;
}
.item-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 6rpx;
}
.price { font-size: 30rpx; font-weight: 700; }
.item-qty { font-size: 26rpx; color: #999; }

.bottom-gap { height: 120rpx; }

.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 100rpx;
  background-color: #fff;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
}
.submit-total {
  flex: 1;
  font-size: 26rpx;
  color: #666;
}
.total { font-size: 36rpx; font-weight: 700; }
.submit-btn {
  background-color: #2ab795;
  color: #fff;
  font-size: 30rpx;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 60rpx;
  border-radius: 40rpx;
}
.submit-btn.disabled { background-color: #b8e3da; }

.addr-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.addr-select {
  font-size: 26rpx;
  color: #2ab795;
}
