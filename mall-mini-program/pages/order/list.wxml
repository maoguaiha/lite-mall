<view class="order-list">
  <!-- 未登录 -->
  <view wx:if="{{!isLogin}}" class="empty">
    <text class="empty-icon">👤</text>
    <text class="empty-text">登录后查看订单</text>
    <view class="btn-primary login-btn" bindtap="goLogin">去登录</view>
  </view>

  <block wx:else>
    <!-- 状态 tab -->
    <view class="tabs">
      <view
        class="tab {{activeTab === index ? 'active' : ''}}"
        wx:for="{{tabs}}"
        wx:key="label"
        data-index="{{index}}"
        bindtap="switchTab"
      >{{item.label}}</view>
    </view>

    <!-- 订单卡片 -->
    <view class="order-card" wx:for="{{orders}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
      <view class="order-head">
        <text class="order-sn">订单号：{{item.orderSn}}</text>
        <text class="order-status">{{item.statusText}}</text>
      </view>
      <view class="order-addr">
        <text class="addr-name">{{item.receiverName}}</text>
        <text class="addr-phone">{{item.receiverPhone}}</text>
        <text class="addr-detail">{{item.address}}</text>
      </view>
      <view class="order-foot">
        <text class="order-total">合计：<text class="text-price"><text class="price-symbol">¥</text>{{item.totalAmount}}</text></text>
        <view class="order-actions" catchtap="noop">
          <view wx:if="{{item.status === 0}}" class="act act-cancel" data-id="{{item.id}}" catchtap="onCancel">取消订单</view>
          <view wx:if="{{item.status === 0}}" class="act act-pay" data-id="{{item.id}}" catchtap="onPay">去支付</view>
          <view wx:if="{{item.status === 2}}" class="act act-pay" data-id="{{item.id}}" catchtap="onConfirm">确认收货</view>
        </view>
      </view>
    </view>

    <view wx:if="{{orders.length === 0 && !loading}}" class="empty">
      <text class="empty-icon">📋</text>
      <text class="empty-text">暂无订单</text>
    </view>
    <view wx:if="{{finished && orders.length > 0}}" class="load-more">没有更多了</view>
    <view wx:if="{{loading}}" class="load-more">加载中...</view>
  </block>
</view>
