.addr-edit { padding: 20rpx; }
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 0 28rpx;
}
.form-item {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.form-item.no-border { border-bottom: none; }
.label {
  width: 140rpx;
  font-size: 28rpx;
  color: #333;
  flex-shrink: 0;
}
.field {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  padding: 20rpx 0;
}
.field.picker.placeholder { color: #bbb; }

.save-btn {
  margin: 40rpx 24rpx 0;
  height: 88rpx;
  background: #2ab795;
  color: #fff;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}
