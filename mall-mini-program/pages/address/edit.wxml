<view class="addr-edit">
  <view class="card">
    <view class="form-item">
      <text class="label">收货人</text>
      <input class="field" placeholder="请输入收货人姓名" value="{{form.name}}" data-field="name" bindinput="onInput" />
    </view>
    <view class="form-item">
      <text class="label">手机号</text>
      <input class="field" placeholder="请输入手机号" value="{{form.phone}}" data-field="phone" bindinput="onInput" type="number" maxlength="11" />
    </view>
    <view class="form-item">
      <text class="label">地区</text>
      <picker mode="region" value="{{form.region}}" bindchange="onRegionChange">
        <view class="field picker {{form.region[0] ? '' : 'placeholder'}}">{{form.regionText}}</view>
      </picker>
    </view>
    <view class="form-item">
      <text class="label">详细</text>
      <input class="field" placeholder="街道、楼牌号等" value="{{form.detailAddress}}" data-field="detailAddress" bindinput="onInput" />
    </view>
    <view class="form-item no-border">
      <text class="label">设为默认</text>
      <switch checked="{{form.isDefault}}" bindchange="onToggleDefault" color="#2ab795" />
    </view>
  </view>

  <view class="save-btn" bindtap="onSave">保存</view>
</view>
