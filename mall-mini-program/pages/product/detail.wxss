.detail {
  padding-bottom: 20rpx;
}

/* 画廊 */
.gallery {
  height: 750rpx;
  background-color: #f5f5f5;
}
.gallery-img { width: 100%; height: 100%; }
.gallery-ph {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  font-size: 120rpx; color: #ccc;
}

/* 头部 */
.head { margin-top: -20rpx; position: relative; z-index: 2; }
.price-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.price-lg { font-size: 48rpx; font-weight: 700; }
.stock { font-size: 24rpx; color: #999; }
.title {
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 16rpx;
  line-height: 44rpx;
}
.subtitle {
  font-size: 26rpx;
  color: #888;
  margin-top: 8rpx;
}
.meta { font-size: 22rpx; color: #999; margin-top: 12rpx; }

/* 规格 */
.spec-block {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.spec-block:last-child { border-bottom: none; }
.spec-key {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 18rpx;
}
.spec-values {
  display: flex;
  flex-wrap: wrap;
}
.spec-value {
  padding: 12rpx 28rpx;
  background-color: #f4f4f4;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #333;
  margin: 0 20rpx 20rpx 0;
}
.spec-value.active {
  background-color: #e6f7f2;
  color: #2ab795;
  border: 1rpx solid #2ab795;
}

/* 数量步进器 */
.stepper {
  display: flex;
  align-items: center;
}
.step-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  text-align: center;
  background-color: #f4f4f4;
  font-size: 36rpx;
  color: #555;
}
.step-input {
  width: 100rpx;
  height: 64rpx;
  text-align: center;
  background-color: #f9f9f9;
  font-size: 28rpx;
  margin: 0 4rpx;
}

/* 详情 */
.detail-content {
  font-size: 28rpx;
  line-height: 44rpx;
  color: #555;
}
.bottom-gap { height: 120rpx; }

/* 底部操作栏 */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 100rpx;
  background-color: #fff;
  display: flex;
  align-items: center;
  padding: 0 16rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
}
.bar-icon {
  width: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #666;
}
.bar-emoji { font-size: 40rpx; }
.bar-emoji.fav { color: #e54d42; }
.bar-label { font-size: 20rpx; margin-top: 2rpx; }
.bar-btns {
  flex: 1;
  display: flex;
}
.bar-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  color: #fff;
  font-size: 30rpx;
  margin: 0 8rpx;
}
.cart-btn { background-color: #ff9a44; border-radius: 40rpx 0 0 40rpx; }
.buy-btn { background-color: #2ab795; border-radius: 0 40rpx 40rpx 0; }
