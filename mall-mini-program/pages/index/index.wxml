<view class="home">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        placeholder="搜索你喜欢的商品"
        value="{{keyword}}"
        confirm-type="search"
        bindinput="onSearchInput"
        bindconfirm="onSearch"
      />
    </view>
    <view class="search-btn" bindtap="onSearch">搜索</view>
  </view>

  <!-- 轮播 banner -->
  <swiper class="banner" indicator-dots autoplay circular indicator-active-color="#fff">
    <swiper-item wx:for="{{banners}}" wx:key="id">
      <view class="banner-item" style="background: {{item.bg}}">
        <view class="banner-title">{{item.title}}</view>
        <view class="banner-sub">{{item.sub}}</view>
      </view>
    </swiper-item>
  </swiper>

  <!-- 分类入口 -->
  <view class="card cat-grid">
    <view
      class="cat-item"
      wx:for="{{categories}}"
      wx:key="id"
      data-id="{{item.id}}"
      data-name="{{item.name}}"
      bindtap="goCategory"
    >
      <view class="cat-icon" wx:if="{{item.img}}">
        <image src="{{item.img}}" mode="aspectFill" />
      </view>
      <view class="cat-icon cat-icon-text" wx:else>{{item.name[0]}}</view>
      <text class="cat-name">{{item.name}}</text>
    </view>
    <view class="cat-item" bindtap="goCategoryPage">
      <view class="cat-icon cat-icon-text">全</view>
      <text class="cat-name">全部分类</text>
    </view>
  </view>

  <!-- 推荐商品 -->
  <view class="section-title"><view class="bar"></view>为你推荐</view>
  <view class="product-grid">
    <view
      class="product-card"
      wx:for="{{recommend}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="goProduct"
    >
      <view class="product-img">
        <image wx:if="{{item.img}}" src="{{item.img}}" mode="aspectFill" />
        <view wx:else class="product-img-ph">🛍</view>
      </view>
      <view class="product-name">{{item.name}}</view>
      <view class="product-sub" wx:if="{{item.subtitle}}">{{item.subtitle}}</view>
      <view class="product-bottom">
        <text class="text-price price"><text class="price-symbol">¥</text>{{item.price}}</text>
        <text class="sales">已售{{item.sales}}</text>
      </view>
    </view>
    <view wx:if="{{recommend.length === 0}}" class="empty">
      <text class="empty-icon">📦</text>
      <text class="empty-text">暂无推荐商品</text>
    </view>
  </view>

  <!-- 新品 -->
  <view class="section-title"><view class="bar"></view>新品上架</view>
  <view class="product-grid">
    <view
      class="product-card"
      wx:for="{{news}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="goProduct"
    >
      <view class="product-img">
        <image wx:if="{{item.img}}" src="{{item.img}}" mode="aspectFill" />
        <view wx:else class="product-img-ph">🛍</view>
      </view>
      <view class="product-name">{{item.name}}</view>
      <view class="product-sub" wx:if="{{item.subtitle}}">{{item.subtitle}}</view>
      <view class="product-bottom">
        <text class="text-price price"><text class="price-symbol">¥</text>{{item.price}}</text>
        <text class="sales">已售{{item.sales}}</text>
      </view>
    </view>
    <view wx:if="{{news.length === 0}}" class="empty">
      <text class="empty-icon">📦</text>
      <text class="empty-text">暂无新品</text>
    </view>
  </view>
</view>
