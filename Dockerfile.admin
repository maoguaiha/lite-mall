# mall-admin (Spring Boot) - multi-stage build
# REGISTRY lets you pull base images from a domestic mirror when Docker Hub
# is unreachable. Override via compose build arg / .env (REGISTRY=.../library/).
ARG REGISTRY=docker.1ms.run/library/
FROM ${REGISTRY}maven:3.9-eclipse-temurin-17 AS build
COPY maven-settings.xml /root/.m2/settings.xml
WORKDIR /build
COPY . .
RUN mvn -q -pl mall-admin -am -DskipTests package

FROM ${REGISTRY}eclipse-temurin:17-jre
WORKDIR /app
COPY --from=build /build/mall-admin/target/mall-admin-1.0-SNAPSHOT.jar app.jar
EXPOSE 8081
ENTRYPOINT ["java", "-jar", "app.jar"]
