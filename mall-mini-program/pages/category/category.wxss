.category {
  display: flex;
  height: 100vh;
  background-color: #fff;
}

/* 左侧 */
.side {
  width: 200rpx;
  background-color: #f4f4f4;
  height: 100%;
}
.side-item {
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  font-size: 28rpx;
  color: #555;
}
.side-item.active {
  background-color: #fff;
  color: #2ab795;
  font-weight: 600;
  border-left: 6rpx solid #2ab795;
}

/* 右侧 */
.content {
  flex: 1;
  height: 100%;
  padding: 20rpx;
}
.sub-grid {
  display: flex;
  flex-wrap: wrap;
}
.sub-item {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 36rpx;
}
.sub-icon {
  width: 110rpx;
  height: 110rpx;
  border-radius: 16rpx;
  background-color: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.sub-icon image { width: 100%; height: 100%; }
.sub-icon-text {
  color: #2ab795;
  font-size: 40rpx;
  font-weight: 700;
}
.sub-name {
  font-size: 24rpx;
  color: #555;
  margin-top: 14rpx;
}
