<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.macro.mall.mapper.PmsProductSkuMapper">
    
    <select id="selectByProductId" resultType="com.macro.mall.model.PmsProductSku">
        SELECT * FROM pms_product_sku WHERE product_id = #{productId} ORDER BY sort ASC
    </select>
    
    <select id="selectByPrimaryKey" resultType="com.macro.mall.model.PmsProductSku">
        SELECT * FROM pms_product_sku WHERE id = #{id}
    </select>
    
    <update id="updateStock">
        UPDATE pms_product_sku SET stock = #{stock}, update_time = NOW() WHERE id = #{id}
    </update>
</mapper>