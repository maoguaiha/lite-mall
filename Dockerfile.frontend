# mall-lite-frontend (Vue 3 + Vite) - multi-stage build -> nginx serve
ARG REGISTRY=docker.1ms.run/library/
FROM ${REGISTRY}node:18-alpine AS build
WORKDIR /app
RUN npm config set registry https://registry.npmmirror.com
COPY mall-lite-frontend/package.json ./
RUN npm install
COPY mall-lite-frontend/ ./
RUN npm run build

FROM ${REGISTRY}nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
