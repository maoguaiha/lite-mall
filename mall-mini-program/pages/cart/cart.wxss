.cart {
  padding: 20rpx 0;
  min-height: 100vh;
}

/* 空状态登录按钮 */
.login-btn {
  margin-top: 30rpx;
  width: 240rpx;
}

/* 购物车项 */
.cart-item {
  display: flex;
  align-items: center;
  background-color: #fff;
  margin: 0 20rpx 20rpx;
  padding: 24rpx;
  border-radius: 16rpx;
}
.check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
  flex-shrink: 0;
}
.check.checked {
  background-color: #2ab795;
  border-color: #2ab795;
}
.item-img {
  width: 160rpx;
  height: 160rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  margin: 0 20rpx;
  overflow: hidden;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.item-img image { width: 100%; height: 100%; }
.item-img-ph { font-size: 60rpx; color: #ccc; }
.item-info {
  flex: 1;
  min-width: 0;
}
.item-name {
  font-size: 28rpx;
  line-height: 36rpx;
  height: 72rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.item-sku {
  font-size: 22rpx;
  color: #999;
  background-color: #f4f4f4;
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
  margin: 10rpx 0;
  display: inline-block;
  max-width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.item-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}
.price { font-size: 32rpx; font-weight: 700; }
.item-del {
  font-size: 36rpx;
  color: #bbb;
  padding: 0 4rpx 0 16rpx;
  align-self: flex-end;
}

/* 步进器 */
.stepper {
  display: flex;
  align-items: center;
}
.step-btn {
  width: 52rpx;
  height: 52rpx;
  line-height: 48rpx;
  text-align: center;
  background-color: #f4f4f4;
  font-size: 32rpx;
  color: #555;
}
.step-input {
  width: 72rpx;
  height: 52rpx;
  text-align: center;
  background-color: #f9f9f9;
  font-size: 26rpx;
  margin: 0 4rpx;
}

.bottom-gap { height: 120rpx; }

/* 结算栏 */
.checkout-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 100rpx;
  background-color: #fff;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
}
.all-label {
  font-size: 26rpx;
  color: #666;
  margin-left: 12rpx;
}
.total-box {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: #666;
  padding-right: 20rpx;
}
.total { font-size: 36rpx; font-weight: 700; }
.checkout-btn {
  background-color: #2ab795;
  color: #fff;
  font-size: 30rpx;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 50rpx;
  border-radius: 40rpx;
}
